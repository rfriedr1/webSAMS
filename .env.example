# Copy this file to `.env` (same folder) and fill in the database line.
# `.env` is ignored by git, so the password never leaves this machine.

# REQUIRED. Which database SAMS Web works on.
#   db_dmams_test2 = test copy (safe to experiment)
#   db_dmams       = the live lab database, shared with BATS
# If the password contains @ : / ? # or %, URL-encode it (@ -> %40).
SAMS_DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@192.168.123.30/db_dmams_test2

# Optional. Where Setup saves its settings (thresholds, e-mail, ...).
# Leave commented to use sams_web/setup_data.json inside this folder.
# SAMS_SETUP_DATA_FILE=C:\ProgramData\webSAMS\setup_data.json

# Optional. Name shown in the browser tab and header.
# SAMS_APP_TITLE=SAMS Web
