{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "webSAMS": {
      "format": "%(asctime)s  webSAMS  %(levelname)-7s  %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "webSAMS-access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(asctime)s  webSAMS  %(levelname)-7s  %(client_addr)s  \"%(request_line)s\"  %(status_code)s",
      "datefmt": "%Y-%m-%d %H:%M:%S",
      "use_colors": false
    }
  },
  "handlers": {
    "default": {
      "class": "logging.StreamHandler",
      "formatter": "webSAMS",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "class": "logging.StreamHandler",
      "formatter": "webSAMS-access",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false},
    "sams_web": {"handlers": ["default"], "level": "INFO", "propagate": false}
  }
}
